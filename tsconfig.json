{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@moi/shared-types": ["./packages/shared-types/src/index.ts"],
      "@moi/policy-engine": ["./packages/policy-engine/src/index.ts"],
      "@moi/textile-adapter": ["./packages/textile-adapter/src/index.ts"],
      "@moi/wallet-signer": ["./packages/wallet-signer/src/index.ts"],
      "@moi/identity": ["./packages/identity/src/index.ts"],
      "@moi/buy-client": ["./packages/buy-client/src/index.ts"],
      "@moi/ledger": ["./packages/ledger/src/index.ts"],
      "@moi/database": ["./packages/database/src/index.ts"],
      "@moi/agent-core": ["./packages/agent-core/src/index.ts"],
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx"],
  "exclude": ["node_modules", "tests"]
}

