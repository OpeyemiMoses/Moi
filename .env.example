# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
GITHUB_REPO=your-org/moi

# SIWE Authentication (EIP-4361 Server-Side Verification)
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_CHAIN_ID=42220
SIWE_NONCE_TTL_SECONDS=300
SIWE_RATE_LIMIT_WINDOW_SECONDS=60
SIWE_RATE_LIMIT_MAX_REQUESTS=30

# Database / queue (Optional for local dev: falls back to ACID transactional file store in ./data/moi-store.json)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moi?schema=public
REDIS_URL=redis://localhost:6379

# Celo Mainnet (chainId: 42220)
CELO_CHAIN_ID=42220
CELO_RPC_URL=https://forno.celo.org
CELO_EXPLORER_URL=https://celoscan.io

# Textile FX v2 (Supports both Partner Bearer API Key AND Keyless EIP-712 TakerControl Proof)
TEXTILE_API_BASE_URL=https://api.textilecredit.com/v2
TEXTILE_API_KEY=
TEXTILE_WEBHOOK_SECRET=

# Agent Signer (Restricted Backend Signer Boundary - NEVER expose to frontend or LLM)
AGENT_WALLET_ADDRESS=
AGENT_SIGNER_PROVIDER=env_restricted_eoa
AGENT_SIGNER_SECRET_REFERENCE=

# ERC-8004 Agent Trust Protocol on Celo Mainnet
ERC8004_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY_ADDRESS=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
ERC8004_AGENT_ID=

# Celo ERC-8021 Onchain Attribution Tag (Issued by Loops House upon enrollment)
CELO_ATTRIBUTION_TAG=celo_c9cb9a59fc4c

# buy / x402 Service Marketplace & Facilitator
BUY_GATEWAY_URL=https://gateway.usebuy.ai
BUY_CATALOG_URL=https://gateway.usebuy.ai/v1/catalog
AGENT402_TOOLS_URL=https://agent402.tools
X402_FACILITATOR_URL=https://api.x402.celo.org
X402_SEPOLIA_FACILITATOR_URL=https://api.x402.sepolia.celo.org
X402_API_KEY=
X402_PAYTO_WALLET=

# Optional Wallet Onboarding
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# LLM (Strictly outside transaction authorization boundary: explanations & draft compilation only)
LLM_API_KEY=
LLM_MODEL=maximo-atlas-1.3

# Observability
LOG_LEVEL=info

